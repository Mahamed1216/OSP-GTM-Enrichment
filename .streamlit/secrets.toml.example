# Copy this file to .streamlit/secrets.toml (gitignored) for local Cloud-parity
# testing, or paste these key/values into Streamlit Community Cloud's
# "Secrets" panel for the deployed app. Every key is mirrored into os.environ
# at startup by app/lib/config.bootstrap_env_from_streamlit_secrets, so they
# flow into src.config.Settings and any spawned subprocess.

# --- LLM ---
ANTHROPIC_API_KEY = ""

# --- Enrichment + research ---
APIFY_API_TOKEN = ""
TAVILY_API_KEY = ""

# --- Email send + verification ---
INSTANTLY_API_KEY = ""
INSTANTLY_CAMPAIGN_ID = ""
EMAIL_VERIFIER = "instantly"  # "instantly" | "neverbounce" | "millionverifier"
NEVERBOUNCE_API_KEY = ""
MILLIONVERIFIER_API_KEY = ""

# --- Tier / send gating ---
SEND_MIN_TIER = "B"  # A | B | C

# --- Storage (Supabase Postgres) ---
DATABASE_URL = "postgresql://postgres:PASSWORD@db.REF.supabase.co:5432/postgres"

# --- Auth ---
# Shared password gate. Leave empty to run in dev-mode (no login required).
APP_PASSWORD = "change-this-to-a-strong-password"

# --- Sender identity ---
SENDER_FIRST_NAME = "Mohammed"
