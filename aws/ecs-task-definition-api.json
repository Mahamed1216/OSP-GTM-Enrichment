{
  "family": "osp-gtm-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::802589444494:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "osp-gtm-api",
      "image": "PLACEHOLDER_IMAGE_REPLACED_BY_WORKFLOW",
      "essential": true,
      "command": ["uvicorn", "src.api.server:app", "--host", "0.0.0.0", "--port", "8000"],
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "SALESOS_INTEGRATION_MODE",
          "value": "false"
        },
        {
          "name": "INSTANTLY_CAMPAIGN_ID",
          "value": ""
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:802589444494:secret:osp-gtm/DATABASE_URL"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:802589444494:secret:osp-gtm/ANTHROPIC_API_KEY"
        },
        {
          "name": "TAVILY_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:802589444494:secret:osp-gtm/TAVILY_API_KEY"
        },
        {
          "name": "APIFY_API_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:802589444494:secret:osp-gtm/APIFY_API_TOKEN"
        },
        {
          "name": "INSTANTLY_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:802589444494:secret:osp-gtm/INSTANTLY_API_KEY"
        },
        {
          "name": "INSTANTLY_WEBHOOK_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:802589444494:secret:osp-gtm/INSTANTLY_WEBHOOK_SECRET"
        },
        {
          "name": "LEAD_SOURCE_JOB_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:802589444494:secret:osp-gtm/LEAD_SOURCE_JOB_SECRET"
        },
        {
          "name": "INTERNAL_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:802589444494:secret:osp-gtm/INTERNAL_API_KEY"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/osp-gtm-api",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
