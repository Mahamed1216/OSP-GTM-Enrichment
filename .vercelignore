# Keeps the upload small. NOTE: the Python function imports src/, and Vercel
# builds the Next.js UI from package.json, next.config.js, pages/, components/,
# lib/ and styles/ — none of those may be ignored here.
.env
.env.local
.git
.github/
.claude/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
*.egg-info/
node_modules/
.next/
.vercel/

# Not used by the serverless function
tests/
docs/
supabase/
scripts/
memory/
logs/
*.db
*.sqlite
*.sqlite3
README.md
