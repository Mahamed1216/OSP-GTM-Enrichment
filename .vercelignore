.env.local
.git
.github/
.claude/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
*.egg-info/
node_modules/
.next/
.vercel/

# Not used by the serverless function
tests/
docs/
supabase/
scripts/
aws/
memory/
logs/
app/pages/
app/PHASE*.md
*.db
*.sqlite
*.sqlite3
.streamlit/
Dockerfile
.dockerignore
docker-compose.yml
requirements-ui.txt
run_webhook.py
README.md
