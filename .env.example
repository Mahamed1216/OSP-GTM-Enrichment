# === Anthropic ===
ANTHROPIC_API_KEY=

# === Apify (LinkedIn enrichment) ===
APIFY_API_TOKEN=
APIFY_ACTOR_LINKEDIN_PROFILE=dev_fusion/Linkedin-Profile-Scraper
APIFY_ACTOR_COMPANY_DETAILS=rigelbytes/linkedin-company-details

# === Tavily (company + industry news) ===
TAVILY_API_KEY=

# === Instantly (delivery + engagement) ===
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=

# === Service secrets (webhook / scheduler / internal API) ===
# Validates inbound Instantly reply webhooks (src.webhook.server).
INSTANTLY_WEBHOOK_SECRET=
# Authorizes POST /api/lead-source/run-scheduled (scheduled imports).
LEAD_SOURCE_JOB_SECRET=
# Bearer token for the internal SalesOS API (/api/v1/* on src.api.server).
INTERNAL_API_KEY=

# === Email verification ===
# Provider options: instantly | neverbounce | millionverifier
EMAIL_VERIFIER=instantly
NEVERBOUNCE_API_KEY=
MILLIONVERIFIER_API_KEY=

# === Models ===
SCORING_MODEL=claude-opus-4-7
CONTENT_MODEL=claude-sonnet-4-6

# === Sender identity (used in content gen sign-off) ===
SENDER_FIRST_NAME=Mohammed

# === Tier thresholds (A: 85+, B: 70-84, C: <70) ===
TIER_A_MIN=85
TIER_B_MIN=70
SEND_MIN_TIER=B

# === SalesOS integration mode ===
# false (default): standalone mode — Streamlit operator UI + manual/confirm
#   Instantly push. Existing behavior is unchanged.
# true: the engine runs as a Dockerized background worker against the shared
#   SalesOS Supabase DB. Sends require an explicit SalesOS CSM approval (tier
#   alone is NOT enough). Streamlit stays available as an internal admin UI.
SALESOS_INTEGRATION_MODE=false

# === Storage ===
DATABASE_URL=sqlite:///sdr.db
LOG_DIR=logs
LOG_LEVEL=INFO

# === Auth (shared password). Leave empty for dev-mode bypass. ===
APP_PASSWORD=
