# OSP GTM Enrichment — environment variables
#
# Copy to .env for local development. On Vercel these are set in
# Project -> Settings -> Environment Variables (.env is never uploaded).
# Nothing here is exposed to the browser: no variable is prefixed NEXT_PUBLIC_,
# so none is inlined into the client bundle.

# --- Required -------------------------------------------------------------
# Supabase Postgres. Use the POOLER URI (port 6543), not the direct 5432
# connection: serverless functions open and drop connections constantly.
# See supabase/README.md.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Bearer token for every /api/v1/* route and the operator console. Any long
# random string; generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=

# --- Pipeline providers ---------------------------------------------------
# Scoring + content generation.
ANTHROPIC_API_KEY=
# LinkedIn profile / company enrichment.
APIFY_API_TOKEN=
# Buyer research and hiring signals.
TAVILY_API_KEY=

# --- Instantly (outbound) -------------------------------------------------
# Shared account key; the campaign id is per workspace, this is the fallback.
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=
# Validates POST /api/instantly/reply-webhook.
INSTANTLY_WEBHOOK_SECRET=

# --- Scheduled jobs -------------------------------------------------------
# Validates POST /api/lead-source/run-scheduled.
LEAD_SOURCE_JOB_SECRET=
# Optional: lets a Vercel Cron call POST /api/v1/drain.
CRON_SECRET=

# --- Scoring configuration (optional; defaults shown) ----------------------
# Leave these unset rather than blank — blank values fall back to the defaults.
EMAIL_VERIFIER=instantly
TIER_A_MIN=85
TIER_B_MIN=70
SEND_MIN_TIER=B
